#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
command=${1:-help}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "missing SHA-256 tool: install sha256sum or shasum" >&2
    exit 1
  fi
}

download_file() {
  source_url=$1
  destination=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$source_url" -o "$destination"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$destination" "$source_url"
  else
    echo "missing download tool: install curl or wget" >&2
    exit 1
  fi
}

sync_resources() {
  git -C "$root" submodule update --init --recursive
}

prepare_resources() {
  sync_resources
  # shellcheck disable=SC1091
  . "$root/resource.lock"
  manifest_file="$root/deps/resource_config/manifests/$manifest"
  cache_dir="$root/.resource-cache"
  artifact_base=${RESOURCE_BASE_URL:-"https://raw.githubusercontent.com/abLiuMing/res_rep/demo-artifacts"}
  mkdir -p "$cache_dir"

  while read -r name version artifact checksum; do
    case "$name" in ''|'#'*) continue ;; esac
    target="$cache_dir/$artifact"
    mkdir -p "$(dirname "$target")"
    if [ ! -f "$target" ] || [ "$(sha256_file "$target")" != "$checksum" ]; then
      echo "fetching $name $version"
      case "$artifact_base" in
        http://*|https://*) download_file "$artifact_base/$artifact" "$target.tmp" ;;
        *) cp "$artifact_base/$artifact" "$target.tmp" ;;
      esac
      actual=$(sha256_file "$target.tmp")
      [ "$actual" = "$checksum" ] || { rm -f "$target.tmp"; echo "checksum mismatch" >&2; exit 1; }
      mv "$target.tmp" "$target"
    else
      echo "cache hit: $name $version"
    fi
  done < "$manifest_file"
}

build_resources() {
  prepare_resources
  . "$root/resource.lock"
  manifest_file="$root/deps/resource_config/manifests/$manifest"
  output="$root/build/generated_resources"
  "$root/deps/resource_config/scripts/build_resources.sh" "$manifest_file" "$root/.resource-cache" "$output"
}

case "$command" in
  sync) sync_resources ;;
  prepare) prepare_resources ;;
  build) build_resources ;;
  run) build_resources; "$root/src/main.sh" ;;
  switch)
    [ "$#" -eq 2 ] || { echo "usage: $0 switch <branch>" >&2; exit 2; }
    git -C "$root" switch "$2"
    sync_resources
    ;;
  status)
    git -C "$root" status --short
    git -C "$root/deps/resource_config" rev-parse --short HEAD
    ;;
  *) echo "usage: $0 {sync|prepare|build|run|switch <branch>|status}" ;;
esac
